        # ------------------ Controls row (analysis + normalization settings) ------------------
        row2 = ttk.Frame(self.root, padding=(8, 0, 8, 4))
        row2.pack(side=tk.TOP, fill=tk.X)

        ttk.Label(row2, text="Artifact method:").grid(row=0, column=0, sticky="w")
